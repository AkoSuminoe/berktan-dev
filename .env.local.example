GITHUB_USERNAME=your_github_username
# Optional: GITHUB_TOKEN=ghp_xxxxxxxxxxxx (increases API rate limit)

# Spotify "Now Playing" module (all three required to activate)
# 1. Create an app at https://developer.spotify.com/dashboard
# 2. Get a refresh token with BOTH of these scopes:
#      user-read-currently-playing   (the live track)
#      user-read-recently-played     (the "Last played" fallback)
#    (authorization code flow, then exchange the code for a refresh token)
#    A token minted with only the first scope still works: the widget just
#    falls back to "Not playing" instead of showing the last track.
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REFRESH_TOKEN=your_spotify_refresh_token

# Cloudflare Web Analytics (optional; the beacon renders nothing without it)
# Dashboard: Cloudflare > Analytics & Logs > Web Analytics > add a site,
# then copy the token out of the snippet it shows you.
#
# NEXT_PUBLIC_ is correct here and is not a secret leak. A beacon token is a
# site identifier, designed to sit in the HTML of every page. It grants no
# access to the dashboard and labels traffic that is already public. Never
# prefix a real credential this way; see AI_MEMORY.md section 5.
#
# IMPORTANT: this one is read at BUILD time, not at start time. NEXT_PUBLIC_
# values are inlined into the output, so it must be in .env.local before
# `npm run build`. Setting it only before `npm start` leaves the beacon
# silently absent. Rebuild after changing it.
NEXT_PUBLIC_CF_BEACON_TOKEN=your_cloudflare_beacon_token

# Contact form delivery (Resend). Without RESEND_API_KEY and CONTACT_FROM the
# endpoint returns "unconfigured" and the form falls back to a mailto: link,
# so the form is never a dead end during local development.
#
# IMPORTANT: verify a SUBDOMAIN in Resend, not the root domain. berktan.dev
# already publishes an SPF record for Cloudflare Email Routing, and a second
# SPF TXT record on the same name is a permanent error that breaks both
# inbound routing and outbound delivery. Verify send.berktan.dev instead and
# leave the root records untouched.
RESEND_API_KEY=re_your_resend_api_key
CONTACT_FROM=Portfolio <noreply@send.berktan.dev>
# Optional. Defaults to siteConfig.email when unset.
CONTACT_TO=hi@berktan.dev
